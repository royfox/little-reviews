{
  "name": "recall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:frontend": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:setup": "wrangler d1 migrations apply recall --local",
    "db:migrate": "wrangler d1 migrations apply recall --remote",
    "db:seed": "node scripts/export-reviews-for-d1.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@google/genai": "*",
    "jose": "^6.2.3",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
